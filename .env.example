# =============================================================================
# bitwarden-vaultwarden-sync — configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# SOURCE — Bitwarden.com (or any hosted Bitwarden-compatible server)
# -----------------------------------------------------------------------------
# Leave BW_SOURCE_URL unset or as shown to use the official Bitwarden.com servers.
BW_SOURCE_URL=https://vault.bitwarden.com
BW_SOURCE_EMAIL=you@example.com
BW_SOURCE_CLIENT_ID=user.xxxxxxxxxxxxxxxxxxxxxxxx
BW_SOURCE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BW_SOURCE_PASSWORD=your-bitwarden-master-password

# -----------------------------------------------------------------------------
# DESTINATION — self-hosted Vaultwarden
# -----------------------------------------------------------------------------
BW_DEST_URL=https://vault.example.com
BW_DEST_EMAIL=you@example.com
BW_DEST_CLIENT_ID=user.xxxxxxxxxxxxxxxxxxxxxxxx
BW_DEST_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BW_DEST_PASSWORD=your-vaultwarden-master-password

# -----------------------------------------------------------------------------
# WIPE METHOD
# "cli"  — deletes items one by one via the bw CLI (default, no extra credentials)
# "api"  — single HTTP call to /api/ciphers/purge (faster for large vaults,
#           requires PBKDF2 KDF; see docs/setup.md if unsure which to use)
# -----------------------------------------------------------------------------
VW_WIPE_METHOD=cli

# -----------------------------------------------------------------------------
# DESTINATION TLS (only needed for a self-signed Vaultwarden certificate)
# -----------------------------------------------------------------------------
# Preferred: trust your own CA and keep verification enabled. Applies to both the
# bw CLI and the api wipe method. The sync refuses to start if the file is missing.
# BW_DEST_CA_BUNDLE=/etc/ssl/certs/my-internal-ca.pem

# Fallback: disable certificate verification entirely. Logs a warning every run.
# BW_DEST_TLS_VERIFY=false

# -----------------------------------------------------------------------------
# BACKUP (recommended — disable only if you manage backups elsewhere)
# -----------------------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_DIR=/var/backups/bw-sync
BACKUP_GPG_PASSPHRASE=choose-a-strong-passphrase
BACKUP_RETENTION_DAYS=7

# -----------------------------------------------------------------------------
# TELEGRAM ALERTS (optional — leave blank to disable)
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# RUNTIME
# -----------------------------------------------------------------------------
# TEMP_DIR should be a tmpfs path so plaintext vault export/backup staging
# never touches disk. /dev/shm is tmpfs on most Linux systems.
TEMP_DIR=/dev/shm/bw-sync

# APPDATA_DIR is a persistent on-disk path (not tmpfs) holding only the bw
# CLI's device identity — see "Device identity" in README.md. Keeping this
# stable across runs stops Bitwarden.com from emailing a "new device" alert
# on every scheduled sync.
APPDATA_DIR=/var/lib/bw-vw-sync

LOG_LEVEL=INFO
